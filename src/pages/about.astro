---
export const prerender = true;

import { SOCIALS } from "@config";
import { techStackByType } from "@utils/getTechStack";
import { Icon } from "astro-icon";
import Layout from "@layouts/Layout.astro";

const routes = [
  { href: "/projects", code: "01", label: "Projects" },
  { href: "/blog", code: "02", label: "Notes" },
  { href: "/search", code: "03", label: "Search" },
];

const activeSocials = SOCIALS.filter(social => social.active);
---

<Layout title="About" description="Mohammed Nasser | About me">
  <article class="about-lab">
    <header class="identity-panel">
      <div class="identity-copy">
        <h1>Mohammed Nasser</h1>
      </div>
    </header>

    <section class="route-section">
      <nav class="route-strip" aria-label="About page routes">
        {
          routes.map(route => (
            <a href={route.href}>
              <span>{route.code}</span>
              <b>{route.label}</b>
            </a>
          ))
        }
      </nav>
    </section>

    <section class="show-console" aria-labelledby="shows-title">
      <div class="console-heading">
        <div>
          <p class="panel-label">Shows</p>
          <h2 id="shows-title">Watchlist</h2>
        </div>
        <div class="carousel-controls">
          <button type="button" data-show-prev aria-label="Previous show">
            <Icon name="ph:arrow-left-bold" />
          </button>
          <button type="button" data-show-next aria-label="Next show">
            <Icon name="ph:arrow-right-bold" />
          </button>
        </div>
      </div>

      <div
        class="show-stage"
        data-show-stage
        data-shows-endpoint="/api/shows.json"
        tabindex="0"
        aria-label="Swipe shows carousel"
      >
      </div>

      <div class="show-dots" data-show-dots aria-label="Choose show"></div>
    </section>

    <section class="stack-console" aria-labelledby="stack-title">
      <p class="panel-label">Stack</p>
      <h2 id="stack-title">Tools</h2>
      <div class="stack-board">
        {
          Object.entries(techStackByType).map(([type, stack]) => (
            <section class="stack-column">
              <h3>{type}</h3>
              <ul>
                {stack.slice(0, 7).map(({ name, icon, url }) => (
                  <li>
                    <a href={url}>
                      <Icon name={icon} />
                      <span>{name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="socials-panel" aria-labelledby="socials-title">
      <div>
        <p class="panel-label">Socials</p>
        <h2 id="socials-title">Links</h2>
      </div>
      <div class="social-grid">
        {
          activeSocials.map(social => (
            <a href={social.href} aria-label={social.linkTitle}>
              <Icon name={social.icon} />
              <span>{social.name}</span>
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>

<script>
  type Show = {
    imdbID: string;
    Poster: string;
    Title: string;
    Plot?: string;
  };

  const showCacheKey = "about:shows:v1";
  const showCacheTtl = 1000 * 60 * 60 * 24;

  const bindShowCarousel = () => {
    const stage = document.querySelector<HTMLElement>("[data-show-stage]");
    const dots = document.querySelector<HTMLElement>("[data-show-dots]");
    const prev = document.querySelector<HTMLButtonElement>("[data-show-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-show-next]");
    if (!stage || !dots || !prev || !next) return;
    if (stage.dataset.bound === "true" || stage.dataset.loading === "true")
      return;

    const createShowSlide = (show: Show, index: number) => {
      const link = document.createElement("a");
      link.href = `https://www.imdb.com/title/${show.imdbID}`;
      link.className = "show-slide";
      link.dataset.showSlide = "";
      link.title = show.Plot ? `${show.Title}: ${show.Plot}` : show.Title;

      const image = document.createElement("img");
      image.src = show.Poster;
      image.alt = show.Title;
      image.width = 150;
      image.height = 225;
      image.loading = "lazy";
      image.decoding = "async";
      image.draggable = false;
      link.append(image);

      const thumb = document.createElement("button");
      thumb.type = "button";
      thumb.dataset.showThumb = "";
      thumb.dataset.index = String(index);
      thumb.ariaLabel = `Show ${show.Title}`;
      if (index === 0) thumb.classList.add("active");

      return { link, thumb };
    };

    const readCachedShows = () => {
      try {
        const raw = sessionStorage.getItem(showCacheKey);
        if (!raw) return null;
        const cached = JSON.parse(raw) as { expiresAt: number; shows: Show[] };
        if (Date.now() > cached.expiresAt) {
          sessionStorage.removeItem(showCacheKey);
          return null;
        }
        return cached.shows;
      } catch {
        return null;
      }
    };

    const writeCachedShows = (shows: Show[]) => {
      try {
        sessionStorage.setItem(
          showCacheKey,
          JSON.stringify({ expiresAt: Date.now() + showCacheTtl, shows })
        );
      } catch {
        // Storage may be unavailable in private browsing; the carousel can still fetch.
      }
    };

    const renderShows = (shows: Show[]) => {
      const fragment = document.createDocumentFragment();
      const dotFragment = document.createDocumentFragment();
      shows.forEach((show, index) => {
        const { link, thumb } = createShowSlide(show, index);
        fragment.append(link);
        dotFragment.append(thumb);
      });
      stage.replaceChildren(fragment);
      dots.replaceChildren(dotFragment);
    };

    const loadShows = async () => {
      const cachedShows = readCachedShows();
      if (cachedShows?.length) {
        renderShows(cachedShows);
        return;
      }

      stage.dataset.loading = "true";
      try {
        const response = await fetch(
          stage.dataset.showsEndpoint || "/api/shows.json"
        );
        if (!response.ok) return;
        const shows = (await response.json()) as Show[];
        renderShows(shows);
        writeCachedShows(shows);
      } finally {
        stage.dataset.loading = "false";
      }
    };

    const bindControls = () => {
      const slides = Array.from(
        document.querySelectorAll<HTMLElement>("[data-show-slide]")
      );
      const thumbs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-show-thumb]")
      );
      if (!slides.length || stage.dataset.bound === "true") return;
      stage.dataset.bound = "true";

      let active = 0;
      const setActive = (index: number) => {
        active = (index + slides.length) % slides.length;
        slides[active]?.scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        });
        thumbs.forEach((thumb, i) =>
          thumb.classList.toggle("active", i === active)
        );
      };

      prev.addEventListener("click", () => setActive(active - 1));
      next.addEventListener("click", () => setActive(active + 1));
      thumbs.forEach(thumb => {
        thumb.addEventListener("click", () =>
          setActive(Number(thumb.dataset.index || 0))
        );
      });

      const updateActiveFromScroll = () => {
        const stageCenter = stage.scrollLeft + stage.clientWidth / 2;
        let closest = 0;
        let closestDistance = Infinity;
        slides.forEach((slide, i) => {
          const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
          const distance = Math.abs(stageCenter - slideCenter);
          if (distance < closestDistance) {
            closest = i;
            closestDistance = distance;
          }
        });
        active = closest;
        thumbs.forEach((thumb, i) =>
          thumb.classList.toggle("active", i === active)
        );
      };

      stage.addEventListener(
        "scroll",
        () => requestAnimationFrame(updateActiveFromScroll),
        { passive: true }
      );
      stage.addEventListener("keydown", event => {
        if (event.key === "ArrowLeft") setActive(active - 1);
        if (event.key === "ArrowRight") setActive(active + 1);
      });
      updateActiveFromScroll();
    };

    const run = () => loadShows().then(bindControls);
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(run, { timeout: 800 });
    } else {
      window.setTimeout(run, 0);
    }
  };

  document.addEventListener("astro:page-load", bindShowCarousel);
  bindShowCarousel();
</script>

<style>
  .about-lab {
    display: grid;
    gap: 16px;
  }

  .about-lab :where(section) {
    max-width: none;
    margin: 0;
  }

  .identity-panel {
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid rgba(9, 44, 46, 0.1);
    border-radius: 4px;
    background: rgba(248, 252, 249, 0.55);
    border-bottom: 1px solid rgba(9, 44, 46, 0.14);
  }

  .identity-copy {
    display: grid;
    align-content: end;
    min-height: clamp(92px, 13vw, 140px);
  }

  .identity-copy h1 {
    margin: 0;
    max-width: 10ch;
  }

  .show-console,
  .stack-console,
  .route-section,
  .socials-panel {
    border: 1px solid rgba(9, 44, 46, 0.14);
    border-radius: 4px;
    background: linear-gradient(
        rgba(157, 242, 255, 0.035) 50%,
        rgba(0, 0, 0, 0.018) 50%
      ),
      rgba(248, 252, 249, 0.86);
    background-size:
      100% 5px,
      auto;
    box-shadow: none;
    padding: clamp(14px, 2.1vw, 24px);
  }

  .about-lab
    > :is(
      .identity-panel,
      .route-section,
      .show-console,
      .stack-console,
      .socials-panel
    ) {
    padding: clamp(14px, 2.1vw, 24px);
  }

  .panel-label {
    color: #137267;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .route-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
  }

  .route-strip a {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: center;
    gap: 2px 12px;
    min-height: 54px;
    padding: 11px;
    border: 1px solid rgba(9, 44, 46, 0.14);
    border-radius: 3px;
    background: linear-gradient(
        rgba(157, 242, 255, 0.055) 50%,
        rgba(0, 0, 0, 0.035) 50%
      ),
      rgba(255, 255, 255, 0.52);
    background-size:
      100% 5px,
      auto;
    color: inherit;
    text-decoration: none;
  }

  .route-strip span {
    color: #137267;
    font-weight: 900;
  }

  .route-strip b {
    color: #092c2e;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 20px;
    line-height: 1;
  }

  .show-console,
  .stack-console,
  .socials-panel {
    min-width: 0;
    overflow: hidden;
  }

  .console-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 10px;
  }

  .panel-label {
    margin: 0 0 8px;
  }

  .show-console h2,
  .stack-console h2,
  .socials-panel h2 {
    margin: 0;
    color: #092c2e;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: clamp(24px, 2.3vw, 36px);
    line-height: 0.96;
  }

  .carousel-controls {
    display: flex;
    gap: 7px;
  }

  .carousel-controls button {
    display: grid;
    width: 36px;
    height: 32px;
    place-items: center;
    border: 1px solid #9df2ff;
    border-radius: 2px;
    background: linear-gradient(
        rgba(157, 242, 255, 0.12) 50%,
        rgba(0, 0, 0, 0.12) 50%
      ),
      #061b24;
    background-size:
      100% 4px,
      auto;
    color: #d9fbff;
    cursor: pointer;
  }

  .carousel-controls svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .show-stage {
    position: relative;
    display: flex;
    gap: 9px;
    height: 226px;
    padding: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid rgba(9, 44, 46, 0.12);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.38);
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x;
  }

  .show-stage::-webkit-scrollbar {
    display: none;
  }

  :global(.show-slide) {
    position: relative;
    flex: 0 0 clamp(104px, 15vw, 138px);
    display: block;
    height: 100%;
    color: inherit;
    scroll-snap-align: center;
    text-decoration: none;
  }

  :global(.show-slide img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid rgba(9, 44, 46, 0.18);
    border-radius: 3px;
    filter: saturate(0.94) contrast(0.96);
    transition:
      border-color 140ms ease,
      filter 140ms ease,
      transform 140ms ease;
  }

  :global(.show-slide:hover img),
  :global(.show-slide:focus-visible img) {
    border-color: #9df2ff;
    filter: saturate(1.05) contrast(1.02);
    transform: translateY(-2px);
  }

  .show-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px;
    margin-top: 8px;
  }

  :global(.show-dots button) {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(9, 44, 46, 0.14);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.44);
    cursor: pointer;
    font-size: 0;
  }

  :global(.show-dots button.active) {
    border-color: #9df2ff;
    background: linear-gradient(
        rgba(157, 242, 255, 0.12) 50%,
        rgba(0, 0, 0, 0.12) 50%
      ),
      #061b24;
    background-size:
      100% 4px,
      auto;
  }

  .stack-board {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }

  .stack-column {
    border-top: 1px solid rgba(9, 44, 46, 0.14);
    padding: 8px 0 0 !important;
  }

  .stack-column h3 {
    margin: 0 0 8px;
    color: #137267;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-column ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-column a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 4px 6px;
    border: 1px solid rgba(9, 44, 46, 0.12);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.5);
    color: #244c4d;
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
  }

  .stack-column svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .socials-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(86px, 1fr));
    gap: 8px;
  }

  .social-grid a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    padding: 7px 9px;
    border: 1px solid rgba(9, 44, 46, 0.12);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.48);
    color: #244c4d;
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .social-grid svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  @media (max-width: 900px) {
    .identity-panel,
    .socials-panel,
    .social-grid {
      grid-template-columns: 1fr;
    }

    .about-lab
      > :is(
        .identity-panel,
        .route-section,
        .show-console,
        .stack-console,
        .socials-panel
      ) {
      padding: 14px;
    }

    .identity-copy {
      min-height: 86px;
    }

    .route-strip {
      grid-template-columns: 1fr;
    }

    .show-stage {
      height: 218px;
    }

    :global(.show-slide) {
      flex-basis: 120px;
    }
  }
</style>
