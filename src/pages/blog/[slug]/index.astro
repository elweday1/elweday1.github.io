---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Datetime from "@components/Datetime.astro";
import ContentTags from "@components/ContentTags.astro";
import { Image } from "astro:assets";
import { SITE } from "@config";
export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const {
  data: { title, description, dateTime, tags, cover },
  slug,
} = post;
const { Content } = await post.render();
---

<Layout
  title={title}
  description={description}
  ogImage={SITE.website + "/blog/" + slug + ".png"}
>
  <main class="detail-page" id="main-content">
    <a class="back-link" href="/blog">Back to writing</a>

    <header class="detail-hero">
      <div>
        <p class="eyebrow">Note File</p>
        <h1>{title}</h1>
      </div>
      <div class="info-panel p-5">
        <Datetime datetime={dateTime} size="lg" />
        <p class="lede">{description}</p>
      </div>
    </header>

    <figure class="detail-cover">
      <Image
        width={1280}
        height={1024}
        alt={description}
        format="avif"
        src={cover}
      />
    </figure>
    <article id="article" role="article" class="prose">
      <Content />
    </article>

    <ContentTags type="tag" tags={tags} />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    let anchorlinks = document.querySelectorAll('a[href^="#"]');

    for (let item of anchorlinks) {
      // relitere
      item.addEventListener("click", e => {
        let hashval = item.getAttribute("href");
        let target = document.querySelector(hashval ?? "");
        target?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
        history.pushState(null, "", hashval);
        e.preventDefault();
      });
    }
  });
</script>
