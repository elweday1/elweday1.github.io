---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import LinkButton from "@components/LinkButton.astro";
import PostCard from "@components/PostCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import getSorted from "@utils/getSorted";
import type { CollectionEntry } from "astro:content";
import Hero from "@components/Hero.astro";
import { Icon } from "astro-icon";
import { Image } from "astro:assets";
import siemens from "@public/logos/siemens.svg";
import deepmind from "@public/logos/deepmind.svg";

const projects = await getSorted("projects");
const posts = await getSorted("blog");
---

<Layout title="Home" description="Mohammed Nasser's personal blog">
  <div class="home-container">
    <!-- Hero Section -->
    <Hero />

    <!-- Experience Section -->
    <section class="experience-section relative py-20 px-6 lg:px-12">
      <div class="container mx-auto max-w-7xl">
        <div class="section-header animate-reveal mb-12" data-delay="0">
          <span class="text-xs font-black uppercase tracking-[0.5em] text-skin-accent/60">01. History</span>
          <h2 class="mt-4 text-4xl font-black tracking-tighter text-skin-base sm:text-6xl">RESEARCH & INDUSTRY<span class="text-skin-accent">_</span></h2>
        </div>

        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <div class="experience-item animate-reveal" data-delay="200">
            <div
              class="group flex flex-col gap-6 rounded-2xl border border-white/5 bg-white/[0.03] p-8 backdrop-blur-sm transition-all hover:bg-white/[0.06] hover:border-skin-accent/20 h-full"
            >
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-900 border border-white/10 p-2 shadow-xl group-hover:scale-110 transition-transform">
                  <Image width={32} height={32} src={deepmind} alt="DeepMind" class="rounded-sm" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-skin-base leading-none">DeepMind</h3>
                  <span class="text-[10px] font-bold uppercase tracking-widest text-skin-accent/60">Zurich, Switzerland</span>
                </div>
              </div>
              <div class="flex-1 space-y-2">
                <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest text-skin-base/30">
                  <span>Jun 2025 — Sep 2025</span>
                  <div class="size-1 rounded-full bg-skin-accent"></div>
                </div>
                <h4 class="text-sm font-bold text-skin-base">Intern Software Engineer</h4>
                <p class="text-xs leading-relaxed text-skin-base/50">Gemini Collaborator: Agentic workflows & novel internal productivity platform on advanced orchestration.</p>
              </div>
            </div>
          </div>

          <div class="experience-item animate-reveal" data-delay="300">
            <div
              class="group flex flex-col gap-6 rounded-2xl border border-white/5 bg-white/[0.03] p-8 backdrop-blur-sm transition-all hover:bg-white/[0.06] hover:border-skin-accent/20 h-full"
            >
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-900 border border-white/10 p-2 shadow-xl group-hover:scale-110 transition-transform">
                  <Image width={32} height={32} src={siemens} alt="Siemens" class="rounded-sm" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-skin-base leading-none">Siemens</h3>
                  <span class="text-[10px] font-bold uppercase tracking-widest text-skin-accent/60">Cairo, EG</span>
                </div>
              </div>
              <div class="flex-1 space-y-2">
                <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest text-skin-base/30">
                  <span>Aug 2024 — May 2025</span>
                  <div class="size-1 rounded-full bg-skin-base/10"></div>
                </div>
                <h4 class="text-sm font-bold text-skin-base">Intern Software Engineer</h4>
                <p class="text-xs leading-relaxed text-skin-base/50">QuestaOne: Full-stack features for hardware IDE, gRPC services, and performant RTL tree-view components.</p>
              </div>
            </div>
          </div>

          <div class="experience-item animate-reveal" data-delay="400">
            <div
              class="group flex flex-col gap-6 rounded-2xl border border-white/5 bg-white/[0.03] p-8 backdrop-blur-sm transition-all hover:bg-white/[0.06] hover:border-skin-accent/20 h-full"
            >
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-900 border border-white/10 p-2 shadow-xl group-hover:scale-110 transition-transform">
                  <div class="flex h-full w-full items-center justify-center font-black text-skin-accent">S</div>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-skin-base leading-none">Studyo</h3>
                  <span class="text-[10px] font-bold uppercase tracking-widest text-skin-accent/60">London, UK (Remote)</span>
                </div>
              </div>
              <div class="flex-1 space-y-2">
                <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest text-skin-base/30">
                  <span>Nov 2023 — Aug 2024</span>
                  <div class="size-1 rounded-full bg-skin-base/10"></div>
                </div>
                <h4 class="text-sm font-bold text-skin-base">Software Engineer (Contract)</h4>
                <p class="text-xs leading-relaxed text-skin-base/50">GCP Architecture: Backend video processing microservices in Go/Python and automated CI/CD pipelines.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    {
      projects.length > 0 && (
        <section class="projects-section relative py-20 px-6 lg:px-12">
          <div class="container mx-auto max-w-7xl">
            <div class="animate-reveal flex flex-col justify-between gap-6 sm:flex-row sm:items-end mb-12" data-delay="0">
              <div>
                <span class="text-xs font-black uppercase tracking-[0.5em] text-skin-accent/60">02. Selected Work</span>
                <h2 class="mt-4 text-4xl font-black tracking-tighter text-skin-base sm:text-6xl">THE WORKSPACE<span class="text-skin-accent">_</span></h2>
              </div>
              <LinkButton href="/projects" className="group flex items-center gap-3 text-xs font-black uppercase tracking-widest text-skin-base/60 hover:text-skin-accent">
                All Projects
                <Icon name="ph:arrow-right-bold" class="size-4 transition-transform group-hover:translate-x-1" />
              </LinkButton>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {projects.slice(0, 4).map((p, index) => (
                <div class="project-item animate-reveal" data-delay={200 + index * 100}>
                  <ProjectCard project={p as CollectionEntry<"projects">} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Blog Posts Section -->
    {
      posts.length > 0 && (
        <section class="posts-section relative py-20 px-6 lg:px-12">
          <div class="container mx-auto max-w-7xl">
            <div class="animate-reveal flex flex-col justify-between gap-6 sm:flex-row sm:items-end mb-12" data-delay="0">
              <div>
                <span class="text-xs font-black uppercase tracking-[0.5em] text-skin-accent/60">03. Archive</span>
                <h2 class="mt-4 text-4xl font-black tracking-tighter text-skin-base sm:text-6xl">THOUGHTS<span class="text-skin-accent">/</span>WRITINGS</h2>
              </div>
              <LinkButton href="/blog" className="group flex items-center gap-3 text-xs font-black uppercase tracking-widest text-skin-base/60 hover:text-skin-accent">
                Inside the Blog
                <Icon name="ph:arrow-right-bold" class="size-4 transition-transform group-hover:translate-x-1" />
              </LinkButton>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {posts.slice(0, 4).map((post, index) => (
                <div class="post-item animate-reveal" data-delay={200 + index * 100}>
                  <PostCard post={post as CollectionEntry<"blog">} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="cta-section relative overflow-hidden py-32 px-6 lg:px-12">
      <div class="container relative z-10 mx-auto max-w-4xl text-center">
        <div class="cta-content animate-reveal" data-delay="0">
          <span class="text-xs font-black uppercase tracking-[0.5em] text-skin-accent/60 mb-6 block">Collaboration</span>
          <h2 class="mb-6 text-5xl font-black tracking-tighter text-skin-base sm:text-7xl">
            LET'S SYNC<span class="text-skin-accent">.</span>
          </h2>
          <p class="mb-12 text-xl font-medium text-skin-base/60 sm:text-2xl">
            Open for <span class="text-skin-base italic">innovative</span> partnerships or just a tech chat.
          </p>
          <div class="flex flex-wrap justify-center gap-6">
            <a href="/about" class="group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-10 py-5 font-bold text-skin-base transition-all hover:bg-white/10 hover:border-skin-accent/30 backdrop-blur-md">
              <span>My Journey</span>
              <Icon name="ph:user-bold" class="size-5" />
            </a>
            <a href="mailto:mohammednh2864@gmail.com" class="group relative flex items-center gap-3 overflow-hidden rounded-2xl bg-skin-accent px-10 py-5 font-bold text-white transition-all hover:scale-[1.02] active:scale-[0.98]">
              <span>Get in Touch</span>
              <Icon name="ph:envelope-simple-bold" class="size-5 transition-transform group-hover:-rotate-12" />
            </a>
          </div>
        </div>
      </div>
      <!-- Artistic Background Detail -->
      <div class="absolute top-1/2 left-1/2 -z-10 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-skin-accent/10 blur-[120px]"></div>
    </section>
  </div>
</Layout>

<style>
  .home-container {
    position: relative;
  }

  /* Experience Section */
  .experience-item {
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Reveal animations */
  .animate-reveal {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-reveal.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .animate-reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

<script>
  function initScrollAnimations() {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px",
    };

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const delay = parseInt(target.dataset.delay || "0");
          setTimeout(() => {
            target.classList.add("is-visible");
          }, delay);
        }
      });
    }, observerOptions);

    // Observe all architectural animated elements
    document
      .querySelectorAll(".animate-reveal")
      .forEach(el => {
        observer.observe(el);
      });

    // Parallax effects
    let ticking = false;
    const heroSection = document.querySelector(".hero-section");

    function updateScrollEffects() {
      const scrollY = window.scrollY;
      
      // Subtle title parallax
      const title = document.querySelector('.hero-title') as HTMLElement;
      if (title && scrollY < 600) {
        title.style.transform = `translateY(${scrollY * 0.15}px)`;
      }

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(updateScrollEffects);
        ticking = true;
      }
    }

    window.addEventListener("scroll", requestTick, { passive: true });
    updateScrollEffects();
  }

  document.addEventListener("DOMContentLoaded", initScrollAnimations);
  document.addEventListener("astro:page-load", initScrollAnimations);
</script>
