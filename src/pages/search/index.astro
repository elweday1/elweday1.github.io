---
import SearchPage from "@layouts/SearchPage.astro";
import Search from "@components/Search.astro";
import getUniqueTags from "@utils/getUniqueTags";
import trim from "@utils/trim";
import Layout from "@layouts/Layout.astro";

const tags = await getUniqueTags("blog", "projects");
const currentPathName = trim(Astro.url.pathname, "/");
const searchType = Astro.url.searchParams.get("type") || "text";
const showTextSearch = searchType === "text" || searchType === null;
---

<Layout title="Search" description="Search through my blog and projects">
  <section class="search-page">
    <header class="search-hero">
      <div>
        <p class="eyebrow">Find Something</p>
        <h1>Search</h1>
      </div>
      <p class="lede">
        Browse the site by phrase or tag across notes, projects, experiments,
        and older build logs.
      </p>
    </header>
    <Search />
  </section>
</Layout>
