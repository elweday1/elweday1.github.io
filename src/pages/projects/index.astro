---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ContentTags from "@components/ContentTags.astro";
import Tag from "@components/Tag.astro";

import getUniqueTags from "@utils/getUniqueTags";

const allTags = await getUniqueTags("projects");
import { type CollectionEntry, getCollection } from "astro:content";
export interface Props {
  pageNum?: number;
  tags?: string[];
}
const allProjects: CollectionEntry<"projects">[] =
  await getCollection("projects");

const experience = [
  {
    role: "Software Engineer",
    org: "Google Health",
    place: "London, UK",
    time: "2026 - Present",
    tone: "current",
    keywords: ["health", "fitbit", "mobile dev"],
    logo: "/logos/google.svg",
  },
  {
    role: "Intern Software Engineer",
    org: "Google DeepMind",
    place: "Zurich, Switzerland",
    time: "Jun 2025 - Sep 2025",
    tone: "previous",
    keywords: ["gemini", "agents", "collaborator"],
    logo: "/logos/deepmind.svg",
  },
  {
    role: "Intern Software Engineer",
    org: "Siemens",
    place: "Cairo, Egypt · Hybrid",
    time: "Aug 2024 - May 2025",
    tone: "previous",
    keywords: ["theia", "grpc", "rtl"],
    logo: "/logos/siemens.svg",
  },
  {
    role: "Software Engineer",
    org: "Studyo",
    place: "London, UK · Remote",
    time: "Nov 2023 - Aug 2024",
    tone: "previous",
    keywords: ["gcp", "video", "automation"],
    logo: "/logos/studyo.svg",
  },
];
---

<Layout
  title="work"
  description="Mohammed Nasser's work, experience, and selected software projects."
>
  <section class="collection-page work-page">
    <h1 class="sr-only">Work</h1>
    <div class="work-dashboard">
      <section aria-labelledby="experience-title" class="experience-board">
        <div class="experience-head">
          <h2 class="section-label" id="experience-title">Experience</h2>
        </div>
        <ol class="experience-list">
          {
            experience.map(item => (
              <li class:list={["experience-card", item.tone]}>
                <div class="experience-rail">
                  <div class="company-mark" aria-hidden="true">
                    <img src={item.logo} alt="" loading="lazy" />
                  </div>
                </div>
                <div class="experience-main">
                  <h2>{item.role}</h2>
                  <h3>{item.org}</h3>
                  <div class="experience-keywords" aria-label="Focus areas">
                    {item.keywords.map(keyword => (
                      <span>{keyword}</span>
                    ))}
                  </div>
                </div>
                <div class="experience-meta">
                  <p>{item.time}</p>
                  <span>{item.place}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="project-tags" class="tag-panel">
        <div class="tag-panel-head">
          <h2 class="section-label" id="project-tags">Tags</h2>
        </div>
        <ContentTags tags={allTags} type="tag">
          <Tag name="View all" type="all" size="lg" />
        </ContentTags>
      </section>
    </div>

    <section class="projects-panel" aria-labelledby="project-files">
      <div class="projects-head">
        <h2 class="section-label" id="project-files">Project Files</h2>
      </div>
      <ul class="work-grid">
        {allProjects.map(project => <ProjectCard project={project} />)}
      </ul>
    </section>
  </section>
</Layout>

<style>
  .work-page {
    gap: 18px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .work-dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(240px, 0.72fr);
    gap: 12px;
    align-items: start;
  }

  .experience-board,
  .tag-panel,
  .projects-panel {
    min-width: 0;
  }

  .experience-head {
    display: block;
  }

  .experience-list {
    position: relative;
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 2px 0 2px 12px;
    list-style: none;
  }

  .experience-list::before {
    content: "";
    position: absolute;
    top: 26px;
    bottom: 26px;
    left: 52px;
    width: 1px;
    background: rgba(19, 114, 103, 0.26);
  }

  .experience-card {
    position: relative;
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) minmax(168px, 0.42fr);
    gap: 14px;
    min-height: 118px;
    padding: 12px 15px 12px 12px;
    border: 1px solid rgba(9, 44, 46, 0.13);
    border-left: 4px solid rgba(19, 114, 103, 0.58);
    border-radius: 5px;
    background: linear-gradient(
        90deg,
        rgba(19, 114, 103, 0.05),
        transparent 42%
      ),
      rgba(248, 252, 249, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 8px 20px rgba(6, 27, 36, 0.035);
  }

  .experience-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(rgba(157, 242, 255, 0.024) 50%, transparent 50%),
      linear-gradient(120deg, transparent 0 68%, rgba(157, 242, 255, 0.13));
    background-size:
      100% 5px,
      auto;
  }

  .experience-card.current {
    border-color: rgba(19, 114, 103, 0.4);
    border-left-color: #137267;
    background: linear-gradient(
        90deg,
        rgba(19, 114, 103, 0.08),
        transparent 45%
      ),
      rgba(242, 251, 247, 0.96);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 10px 24px rgba(6, 27, 36, 0.06);
  }

  .experience-rail {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 94px;
    place-items: center;
    min-width: 0;
    border-right: 1px solid rgba(9, 44, 46, 0.11);
  }

  .company-mark {
    display: grid;
    width: 82px;
    height: 72px;
    place-items: center;
    border: 1px solid rgba(9, 44, 46, 0.13);
    border-radius: 6px;
    background: linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.72),
        transparent 58%
      ),
      rgba(248, 252, 249, 0.96);
    box-shadow:
      0 0 0 5px rgba(238, 244, 239, 0.92),
      inset 0 0 22px rgba(157, 242, 255, 0.12),
      0 8px 16px rgba(6, 27, 36, 0.055);
  }

  .company-mark img {
    display: block;
    width: 60px;
    height: auto;
    max-width: 62px;
    max-height: 42px;
    object-fit: contain;
  }

  .company-mark img[src$="google.svg"] {
    width: 44px;
    max-width: 44px;
  }

  .company-mark img[src$="deepmind.svg"] {
    width: 44px;
    max-width: 44px;
  }

  .company-mark img[src$="siemens.svg"] {
    width: 78px;
    max-width: 78px;
  }

  .company-mark img[src$="studyo.svg"] {
    width: 70px;
    max-width: 70px;
  }

  .experience-main {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 7px;
    min-width: 0;
  }

  .experience-card h2,
  .experience-card h3 {
    margin: 0;
  }

  .experience-meta {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: end;
    gap: 6px;
    min-width: 0;
    padding-left: 16px;
    border-left: 1px solid rgba(9, 44, 46, 0.1);
    text-align: right;
  }

  .experience-meta p {
    margin: 0;
    color: #137267;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-meta span {
    color: #486566;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
  }

  .experience-card h2 {
    overflow: hidden;
    color: #092c2e;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: clamp(20px, 1.5vw, 28px);
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .experience-card h3 {
    color: #137267;
    font-size: 12px;
    font-weight: 900;
  }

  .experience-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 12px;
    margin-top: 4px;
  }

  .experience-keywords span {
    position: relative;
    color: rgba(9, 44, 46, 0.5);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-keywords span:not(:last-child)::after {
    content: "/";
    position: absolute;
    right: -9px;
    color: #9df2ff;
  }

  .tag-panel {
    padding-top: 2px;
  }

  .tag-panel-head,
  .projects-head {
    display: block;
  }

  :global(.work-page .tag-bank) {
    gap: 8px 10px;
    padding: 8px 0 0;
  }

  :global(.work-page .site-tag) {
    min-height: 24px;
  }

  :global(.work-page .work-grid) {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
  }

  :global(.work-page .work-card) {
    border-radius: 5px !important;
    background: rgba(248, 252, 249, 0.9);
  }

  :global(.work-page .work-card::before) {
    display: none;
  }

  :global(.work-page .work-card-media) {
    aspect-ratio: 1.9;
  }

  :global(.work-page .work-card-body) {
    gap: 9px;
    padding: 13px;
  }

  :global(.work-page .work-card p) {
    display: -webkit-box;
    min-height: 2.7em;
    overflow: hidden;
    color: rgba(9, 44, 46, 0.62);
    font-size: 12px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.work-page .card-link-row) {
    margin: auto 13px 13px;
  }

  @media (max-width: 900px) {
    .work-dashboard {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .experience-card {
      grid-template-columns: 78px minmax(0, 1fr);
      gap: 12px;
      padding: 10px 11px 10px 10px;
    }

    .experience-list::before {
      left: 43px;
    }

    .experience-rail {
      grid-row: 1 / span 2;
      min-height: 84px;
    }

    .company-mark {
      width: 64px;
      height: 58px;
    }

    .company-mark img {
      width: 48px;
      max-width: 48px;
      max-height: 32px;
    }

    .company-mark img[src$="google.svg"],
    .company-mark img[src$="deepmind.svg"] {
      width: 36px;
      max-width: 36px;
    }

    .company-mark img[src$="siemens.svg"] {
      width: 58px;
      max-width: 58px;
    }

    .company-mark img[src$="studyo.svg"] {
      width: 54px;
      max-width: 54px;
    }

    .experience-meta {
      grid-column: 2;
      justify-items: start;
      padding-left: 0;
      border-left: 0;
      text-align: left;
    }

    .experience-card h2 {
      white-space: normal;
    }
  }
</style>
