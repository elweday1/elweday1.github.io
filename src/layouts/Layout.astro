---
import { SITE } from "@config";
import "@styles/base.css";
import { ViewTransitions } from "astro:transitions";
import Batman from "@components/bg.astro";
import Header from "@components/Header.astro";
// import Footer from "@components/Footer.astro";
import Scroller from "@components/Scroller.astro";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const toTitleCase = function (str: string) {
  return str.replace(/\w\S*/g, function (txt: string) {
    return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
  });
};

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

let { title = SITE.title, description = SITE.desc, ogImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const { title: siteTitle } = SITE;

const path = title;
const pageTitle = siteTitle + " | " + toTitleCase(title);

ogImage = ogImage ? ogImage : SITE.website + "/assets/images/fallback.png";
---

<!doctype html>
<html
  class="h-full w-full overscroll-y-contain motion-safe:scroll-smooth"
  lang="en"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <!-- General Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="sitemap" href={SITE.website + "/rss.xml"} />
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Nunito:wght@700;1000&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Nunito:wght@700;1000&display=swap"
    />

    <meta name="theme-color" content="" />

    {
      /*  If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
    include google-site-verification tag in the heading
     Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
    */
    }
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
    <ViewTransitions />

    <style is:global>
      :root {
        color-scheme: light dark;
      }
      html {
        content-visibility: visible;
      }

      @media (prefers-color-scheme: light) {
        html {
          background-color: rgb(242, 245, 248);
        }
      }

      @media (prefers-color-scheme: dark) {
        html {
          background-color: rgb(30, 32, 35);
        }
        html {
          color-scheme: dark;
        }
      }
    </style>
    <style>
      #main-body:nth-child(3) {
        container-name: main-body;
        container-type: size;
      }
    </style>
  </head>
  <body class="h-screen w-screen overflow-hidden">
    <Batman />

    <div
      style="background-color: rgba(15, 15, 15, 0.5);"
      class="main-container flex h-full w-full flex-col place-self-center overflow-hidden rounded-xl px-4 backdrop-blur-xl md:my-7 md:max-w-6xl"
    >
      <Header path={path} />
      <main
        style={{ scrollSnapType: "y mandatory" }}
        class="w-full flex-1 place-self-center overflow-y-auto overflow-x-clip pb-8"
        id="main-body"
      >
        <Scroller />
        <slot />
      </main>
    </div>
  </body>
</html>
