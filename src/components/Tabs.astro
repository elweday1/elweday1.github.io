---
import trim from "@utils/trim";
const TABS = [
  { name: "Search by text", path: "search", type: "text" },
  { name: "Search by tag", path: "search", type: "tag" },
];

const currentPathName = trim(Astro.url.pathname, "/");
const searchType = Astro.url.searchParams.get("type") || "text";
---

<ul
  class="relative my-4 flex w-full list-none flex-wrap rounded-lg bg-skin-fill p-2"
  data-tabs="tabs"
  role="list"
>
  {
    TABS.map(({ name, path, type }) => {
      const isActive =
        (type === "text" && (searchType === "text" || searchType === null)) ||
        (type === "tag" && searchType === "tag");
      return (
        <li class="relative z-30 flex-auto cursor-pointer text-center">
          {isActive ? (
            <div class="absolute h-full w-full rounded-lg bg-skin-accent/30" />
          ) : null}
          <a
            href={`/${path}?type=${type}`}
            class="z-30 mb-0 flex w-full items-center  justify-center rounded-lg border-0 py-1 transition-all ease-in-out  "
            data-tab-target=""
            role="tab"
            aria-selected={isActive}
          >
            <span class="ml-1">{name}</span>
          </a>
        </li>
      );
    })
  }
</ul>
