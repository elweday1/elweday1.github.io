---
import { Technologies } from "@config";
import Icon from "astro-icon";

const activeIcons = Object.values(Technologies)
  .filter(t => t.display)
  .map(t => t.icon);

const rows = Array.from({ length: 140 });
const cols = Array.from({ length: 80 });
---

<div
  id="bg-boundary"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 z-10"
    style="background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0, 0.4) 70%, rgba(0,0,0, 0.8) 100%);"
  >
  </div>

  <div id="icon-library" class="hidden">
    {
      activeIcons.map(iconName => (
        <div data-icon-name={iconName}>
          <Icon
            name={iconName}
            class="pointer-events-none relative z-20 block text-[2.8rem]"
          />
        </div>
      ))
    }
  </div>

  <div
    id="boxes-container"
    class="pointer-events-none absolute inset-0 z-0 flex h-[150vh] w-[150vw] bg-transparent"
    style="transform: translate(-25%, -25%) skewX(-48deg) skewY(14deg) scale(1.6); transform-origin: center;"
  >
    {
      rows.map((_, i) => (
        <div class="row relative h-12 w-24 border-l border-slate-700/10">
          {cols.map((_, j) => (
            <div
              data-box
              class="box pointer-events-auto relative flex h-12 w-24 items-center justify-center border-r border-t border-slate-700/10"
            >
              {j % 4 === 0 && i % 4 === 0 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1"
                  stroke="currentColor"
                  class="pointer-events-none absolute -left-[22px] -top-[14px] h-6 w-10 text-slate-700/15"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v12m6-6H6"
                  />
                </svg>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  const colors = [
    "#FFD400",
    "#FF9100",
    "#FF4646",
    "#F06292",
    "#BA68C8",
    "#9575CD",
    "#7986CB",
    "#64B5F6",
    "#4FC3F7",
    "#4DD0E1",
    "#4DB6AC",
    "#81C784",
    "#AED581",
    "#DCE775",
    "#FF8A65",
  ];

  const initBackground = () => {
    const library = document.getElementById("icon-library");
    const iconTemplates = library ? Array.from(library.children) : [];
    const boxes = document.querySelectorAll("[data-box]");

    boxes.forEach(box => {
      if (box.hasAttribute("data-bg-initialized")) return;
      box.setAttribute("data-bg-initialized", "true");

      let isAnimating = false;

      box.addEventListener("mouseenter", () => {
        if (isAnimating || !iconTemplates.length) return;

        isAnimating = true;
        const randomTemplate =
          iconTemplates[Math.floor(Math.random() * iconTemplates.length)];
        const randomColor = colors[Math.floor(Math.random() * colors.length)];

        // Clone the pre-rendered SVG from the library
        const iconWrapper = randomTemplate.cloneNode(true) as HTMLElement;
        const iconSvg = iconWrapper.querySelector("svg");

        if (iconSvg) {
          iconSvg.style.color = randomColor;
          iconSvg.style.filter = `drop-shadow(0 0 18px ${randomColor})`;
          box.appendChild(iconSvg);

          // Native Web Animations API - Entrance
          const iconIn = iconSvg.animate(
            [
              {
                opacity: 0,
                transform: "scale(0.3) skewX(48deg) skewY(-14deg)",
              },
              { opacity: 1, transform: "scale(1) skewX(48deg) skewY(-14deg)" },
            ],
            { duration: 150, fill: "forwards", easing: "ease-out" }
          );

          const boxIn = box.animate(
            [
              { backgroundColor: "transparent" },
              { backgroundColor: randomColor + "26" },
            ],
            { duration: 150, fill: "forwards" }
          );

          // Wait 2s then exit
          setTimeout(async () => {
            const iconOut = iconSvg.animate(
              [
                {
                  opacity: 1,
                  transform: "scale(1) skewX(48deg) skewY(-14deg)",
                },
                {
                  opacity: 0,
                  transform: "scale(0.2) skewX(48deg) skewY(-14deg)",
                },
              ],
              { duration: 400, fill: "forwards", easing: "ease-in" }
            );

            box.animate(
              [
                { backgroundColor: randomColor + "26" },
                { backgroundColor: "transparent" },
              ],
              { duration: 400, fill: "forwards" }
            );

            await iconOut.finished;
            iconSvg.remove();
            isAnimating = false;
          }, 2000);
        }
      });
    });
  };

  initBackground();
  document.addEventListener("astro:page-load", initBackground);
</script>
