---
import { Technologies } from "@config";
import { Icon } from "astro-icon";

const activeIcons = Object.values(Technologies)
  .filter(t => t.display)
  .map(t => t.icon);
---

<div
  id="bg-boundary"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 z-10"
    style="background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0, 0.4) 70%, rgba(0,0,0, 0.8) 100%);"
  >
  </div>

  <div
    id="interactive-grid"
    class="pointer-events-auto absolute inset-0 z-0"
    style="
      width: 200vw; height: 200vh;
      transform: translate(-25%, -25%) skewX(-48deg) skewY(14deg) scale(1.6);
      background-size: 96px 48px;
      background-image: 
        linear-gradient(to right, rgba(51, 65, 85, 0.15) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(51, 65, 85, 0.15) 1px, transparent 1px);
    "
  >
    <div class="absolute inset-0 opacity-15"></div>
  </div>

  <div id="icon-library" class="hidden">
    {
      activeIcons.map(name => (
        <div data-template>
          <Icon name={name} class="text-[2.8rem]" />
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  .spawn-box {
    position: absolute;
    width: 96px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .spawn-svg {
    transform: skewY(-14deg) skewX(48deg);
    animation: icon-life 1.5s forwards cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes icon-life {
    0% {
      opacity: 0;
      transform: skewY(-14deg) skewX(48deg) scale(0);
    }
    15% {
      opacity: 1;
      transform: skewY(-14deg) skewX(48deg) scale(1);
    }
    85% {
      opacity: 1;
      transform: skewY(-14deg) skewX(48deg) scale(1);
    }
    100% {
      opacity: 0;
      transform: skewY(-14deg) skewX(48deg) scale(0);
    }
  }
</style>

<script>
  const COLORS = ["#FFD400", "#FF4646", "#BA68C8", "#64B5F6", "#81C784"];
  const W = 96;
  const H = 48;

  // Keep state outside init to survive minor re-renders
  let busyCells = new Set();

  const handleMouseMove = (e: MouseEvent) => {
    const grid = e.currentTarget as HTMLElement;
    const cellX = Math.floor(e.offsetX / W) * W;
    const cellY = Math.floor(e.offsetY / H) * H;
    const id = `${cellX}-${cellY}`;

    if (busyCells.has(id)) return;
    busyCells.add(id);

    const library = document.getElementById("icon-library");
    const templates = library?.querySelectorAll("[data-template]");
    if (!templates || templates.length === 0) return;

    const color = COLORS[Math.floor(Math.random() * COLORS.length)];
    const template = templates[Math.floor(Math.random() * templates.length)];

    const wrapper = document.createElement("div");
    wrapper.className = "spawn-box";
    wrapper.style.left = `${cellX}px`;
    wrapper.style.top = `${cellY}px`;
    wrapper.style.backgroundColor = color + "15";

    const svg = (template.querySelector("svg") as SVGElement).cloneNode(
      true
    ) as SVGElement;
    svg.classList.add("spawn-svg");
    svg.style.color = color;
    svg.style.filter = `drop-shadow(0 0 15px ${color})`;

    wrapper.appendChild(svg);
    grid.appendChild(wrapper);

    setTimeout(() => {
      wrapper.remove();
      busyCells.delete(id);
    }, 1500);
  };

  const init = () => {
    const grid = document.getElementById("interactive-grid") as HTMLElement;
    if (!grid || grid.dataset.hasListener) return;

    // Reset state on new page load
    busyCells.clear();

    // Use rAF to wait for the browser to be "ready" after first paint
    requestAnimationFrame(() => {
      grid.addEventListener("mousemove", handleMouseMove, { passive: true });
      grid.dataset.hasListener = "true";
    });
  };

  // Start logic
  init();
  document.addEventListener("astro:page-load", init);

  // Clean up set on before-swap to prevent memory leaks
  document.addEventListener("astro:before-swap", () => {
    busyCells.clear();
  });
</script>
