---
import Datetime from "./Datetime.astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon";
import { twMerge } from "tailwind-merge";
import { Technologies } from "@config";
import { Image } from "astro:assets";
import { slugifyStr } from "@utils/slugify";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className } = Astro.props;
const { data, slug } = project;
const {
  title,
  cover,
  stack,
  tags,
  dateTime,
  endDate,
  projectURL,
  githubURL,
  description,
} = data;

const strTags = tags.map((tag: string) => slugifyStr(tag)).join("/");
---

<li
  data-item-type="search-item"
  data-slug={slug}
  data-tags={strTags}
  data-title={slug}
  class={twMerge("group relative overflow-hidden rounded-xl bg-skin-card transition-all duration-300 hover:shadow-lg hover:shadow-skin-accent/20", className)}
  transition:name={slug + ":cover"}
>
  <a
    href={`/projects/${slug}`}
    class="block"
    aria-label={`View ${title}`}
  >
    <div class="relative aspect-video overflow-hidden">
      <Image
        transition:name={slug + ":image"}
        alt={description}
        width={600}
        height={400}
        format="avif"
        src={cover}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-transparent"></div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <div class="rounded-lg bg-black/20 backdrop-blur-md border border-white/10 p-3">
        <Datetime
          datetime={dateTime}
          endDate={endDate}
          size="sm"
          class="mb-1 text-xs text-white/90"
        />
        <h2 
          class="mb-2 text-lg font-bold text-white sm:text-xl" 
          transition:name={slug}
        >
          {title}
        </h2>
        <p class="mb-3 text-sm text-white/90" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
          {description}
        </p>
        
        <div class="flex flex-wrap gap-2">
          {
            (stack as (keyof typeof Technologies)[]).slice(0, 4).map(technology => {
              const { name, icon } = Technologies[technology];
              return (
                <div
                  class="flex items-center gap-1 rounded-md bg-white/20 px-2 py-1 backdrop-blur-sm"
                  title={name}
                >
                  <Icon
                    transition:name={slug + ":stack:" + name}
                    class="size-4 text-white"
                    name={icon}
                  />
                  <span class="text-xs text-white">{name}</span>
                </div>
              );
            })
          }
          {stack.length > 4 && (
            <div class="flex items-center rounded-md bg-white/20 px-2 py-1 backdrop-blur-sm">
              <span class="text-xs text-white">+{stack.length - 4}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </a>

  <!-- Action buttons overlay -->
  <div class="absolute right-4 top-4 flex gap-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
    {githubURL && (
      <a
        href={githubURL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub"
        class="flex h-10 w-10 items-center justify-center rounded-lg bg-black/80 backdrop-blur-sm text-white transition-all hover:bg-black hover:scale-110"
        onclick={(e) => e.stopPropagation()}
      >
        <Icon class="size-5" name="teenyicons:github-solid" />
      </a>
    )}
    {projectURL && (
      <a
        href={projectURL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit project"
        class="flex h-10 w-10 items-center justify-center rounded-lg bg-black/80 backdrop-blur-sm text-white transition-all hover:bg-black hover:scale-110"
        onclick={(e) => e.stopPropagation()}
      >
        <Icon class="size-5" name="mdi:web" />
      </a>
    )}
  </div>
</li>
