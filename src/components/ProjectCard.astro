---
import Datetime from "./Datetime.astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon";
import { twMerge } from "tailwind-merge";
import { Technologies } from "@config";
import { Image } from "astro:assets";
import { slugifyStr } from "@utils/slugify";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className } = Astro.props;
const { data, slug } = project;
const {
  title,
  cover,
  stack,
  tags,
  dateTime,
  endDate,
  projectURL,
  githubURL,
  description,
} = data;

const strTags = tags.map((tag: string) => slugifyStr(tag)).join("/");
---

<li
  data-item-type="search-item"
  data-slug={slug}
  data-tags={strTags}
  data-title={slug}
  class={twMerge("group relative overflow-hidden rounded-2xl border border-white/5 bg-white/[0.03] backdrop-blur-sm transition-all duration-500 hover:border-skin-accent/30 hover:bg-white/[0.08] hover:shadow-2xl hover:shadow-skin-accent/5", className)}
>
  <a
    href={`/projects/${slug}`}
    class="block"
    aria-label={`View ${title}`}
  >
    <div class="relative aspect-video overflow-hidden">
      <Image
        transition:name={slug + ":image"}
        alt={description}
        width={600}
        height={400}
        format="avif"
        src={cover}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
      />
      <!-- Artistic gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
      
      <!-- Top info: Status or Year -->
      <div class="absolute top-4 left-4">
        <div class="rounded-full border border-white/10 bg-black/40 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-white/60 backdrop-blur-md">
           {endDate ? "Completed" : "Active Development"}
        </div>
      </div>
    </div>
    
    <div class="p-6">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-skin-accent/80">Project.log</span>
        <div class="flex gap-1">
           <div class="size-1 rounded-full bg-skin-accent"></div>
           <div class="size-1 rounded-full bg-skin-accent/40"></div>
        </div>
      </div>

      <h2 
        class="mb-2 text-2xl font-black tracking-tight text-skin-base group-hover:text-skin-accent transition-colors" 
        transition:name={slug}
      >
        {title}
      </h2>
      
      <p class="mb-6 line-clamp-2 text-sm leading-relaxed text-skin-base/60">
        {description}
      </p>
      
      <div class="flex flex-wrap gap-2">
        {
          (stack as (keyof typeof Technologies)[]).slice(0, 3).map(technology => {
            const tech = Technologies[technology];
            if (!tech) return null;
            const { name, icon } = tech;
            return (
              <div
                class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/5 px-2.5 py-1.5 transition-colors group-hover:border-skin-accent/20 group-hover:bg-skin-accent/5"
                title={name}
              >
                <Icon
                  transition:name={slug + ":stack:" + name}
                  class="size-3.5 text-skin-base/40 group-hover:text-skin-accent transition-colors"
                  name={icon}
                />
                <span class="text-[10px] font-bold uppercase tracking-wider text-skin-base/40 group-hover:text-skin-base transition-colors">{name}</span>
              </div>
            );
          })
        }
        {stack.length > 3 && (
          <div class="flex items-center rounded-lg border border-white/5 bg-white/5 px-2.5 py-1.5 font-bold text-[10px] text-skin-base/30">
            +{stack.length - 3}
          </div>
        )}
      </div>
    </div>
  </a>

  <!-- Action buttons overlay - Cleaned up -->
  <div class="absolute right-6 top-6 flex gap-2 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">
    {githubURL && (
      <a
        href={githubURL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-black/60 text-white backdrop-blur-md transition-all hover:bg-black hover:border-skin-accent hover:scale-110"
      >
        <Icon class="size-5" name="ph:github-logo-fill" />
      </a>
    )}
    {projectURL && (
      <a
        href={projectURL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit project"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-black/60 text-white backdrop-blur-md transition-all hover:bg-black hover:border-skin-accent hover:scale-110"
      >
        <Icon class="size-5" name="ph:browser-bold" />
      </a>
    )}
  </div>
</li>
