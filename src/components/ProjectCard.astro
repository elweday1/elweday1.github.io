---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon";
import { twMerge } from "tailwind-merge";
import { Technologies } from "@config";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className } = Astro.props;
const { data, slug } = project;
const {
  title,
  cover,
  stack,
  githubURL,
  projectURL,
  description,
} = data;
const cardCode = `P-${String(
  (Array.from(slug).reduce((sum, char) => sum + char.charCodeAt(0), 0) % 89) + 10
)}`;
---

<li
  data-item-type="search-item"
  data-slug={slug}
  data-title={slug}
  data-card-code={cardCode}
  class={twMerge("work-card group", className)}
>
  <a href={`/projects/${slug}`} class="work-card-anchor" aria-label={`View ${title}`}>
    <div class="work-card-media">
      <Image
        alt={description}
        width={600}
        height={400}
        format="avif"
        src={cover}
      />
    </div>

    <div class="work-card-body">
      <span class="card-kicker">Project</span>
      <h2>{title}</h2>

      <p>{description}</p>

      <div class="card-chip-row">
        {
          (stack as (keyof typeof Technologies)[])
            .slice(0, 2)
            .map(technology => {
              const tech = Technologies[technology];
              if (!tech) return null;
              const { name, icon } = tech;
              return (
                <div
                  class="card-chip"
                  title={name}
                >
                  <Icon name={icon} />
                  <span>{name}</span>
                </div>
              );
            })
        }
        {
          stack.length > 2 && (
            <div class="card-chip">
              +{stack.length - 2}
            </div>
          )
        }
      </div>
    </div>
  </a>
  <div class="card-link-row" aria-label={`${title} links`}>
    <a href={`/projects/${slug}`}>Read</a>
    {
      githubURL && (
        <a href={githubURL} target="_blank" rel="noopener noreferrer">
          <Icon name="ph:github-logo-fill" />
          GitHub
        </a>
      )
    }
    {
      projectURL && (
        <a href={projectURL} target="_blank" rel="noopener noreferrer">
          <Icon name="ph:browser-bold" />
          Site
        </a>
      )
    }
  </div>
</li>
