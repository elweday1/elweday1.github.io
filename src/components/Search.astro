---
// Critical Fix 1: Ensure Cloudflare processes searchParams at runtime
export const prerender = false;

import { getCollection } from "astro:content";
import Datetime from "./Datetime.astro";
import removeMd from "remove-markdown";
import { Icon } from "astro-icon";
import Tag from "./Tag.astro";
import getUniqueTags from "@utils/getUniqueTags";

const posts = await getCollection("blog");
const projects = await getCollection("projects");
const allEntries = [...posts, ...projects];
const allTags = await getUniqueTags("blog", "projects");

const urlTags = Astro.url.searchParams.getAll("tag");
const urlQuery = Astro.url.searchParams.get("q") || "";

const processedEntries = allEntries.map(entry => ({
  slug: entry.slug,
  collection: entry.collection,
  title: entry.data.title,
  description: entry.data.description,
  tags: entry.data.tags || [],
  bodyPlainText: removeMd(entry.body),
  dateTime: entry.data.dateTime,
  endDate: entry.data.endDate,
}));

// Critical Fix 2: Object map for O(1) lookup by slug
const searchDataMap = processedEntries.reduce((acc, entry) => {
  acc[entry.slug] = entry;
  return acc;
}, {});
---

<div class="search-container search-panel">
  <label class="relative mb-8 block">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 opacity-60">
      <Icon name="ion:search" class="size-5" />
    </span>
    <input
      id="search-input"
      value={urlQuery}
      class="search-input"
      placeholder="Search projects and posts..."
      type="text"
      autocomplete="off"
    />
  </label>

  <div class="mb-10">
    <h2 class="section-label">Filter by Tags</h2>
    <ul class="tag-bank">
      {
        allTags.map(tag => (
          <label
            for={tag}
            class="relative cursor-pointer transition-all duration-200"
          >
            <input
              name="tag-filter"
              id={tag}
              value={tag}
              type="checkbox"
              hidden
              class="peer"
              checked={urlTags.includes(tag)}
            />
            <Tag
              name={tag}
              size="lg"
              type="category"
              class="peer-checked:ring-2 peer-checked:ring-skin-accent"
            />
          </label>
        ))
      }
    </ul>
  </div>

  <div id="results-wrapper">
    <p id="number-of-results" class="eyebrow">
    </p>

    <div
      id="empty-state"
      class="flex hidden flex-col items-center justify-center py-20 text-center opacity-50"
    >
      <Icon name="ion:search" class="mb-4 size-16" />
      <p class="text-xl font-bold">No results found</p>
    </div>

    <ul id="search-results" class="grid grid-cols-1 gap-4">
      {
        processedEntries.map(entry => (
          <a
            href={`/${entry.collection}/${entry.slug}`}
            data-item
            data-slug={entry.slug}
            class="search-result-card hidden"
          >
            <div class="mb-3 flex w-full flex-row justify-between">
              <Datetime
                size="sm"
                datetime={entry.dateTime}
                endDate={
                  entry.collection === "blog" ? undefined : entry.endDate
                }
              />
              <div class="flex items-center gap-1 opacity-70">
                <Icon
                  class="size-4"
                  name={
                    entry.collection === "blog"
                      ? "ant-design:read-outlined"
                      : "ic:baseline-code"
                  }
                />
                <span class="text-xs font-medium uppercase">
                  {entry.collection === "blog" ? "Post" : "Project"}
                </span>
              </div>
            </div>
            <span class="text-xl font-bold" data-field="title">
              {entry.title}
            </span>
            <p class="text-sm opacity-80" data-field="description">
              {entry.description}
            </p>
            <div class="mt-auto flex flex-wrap gap-2" data-result-tags />
          </a>
        ))
      }
    </ul>
  </div>
</div>

<div id="search-data" data-json={JSON.stringify(searchDataMap)} class="hidden">
</div>

<script>
  function initSearch() {
    const dataEl = document.getElementById("search-data");
    const input = document.getElementById("search-input");
    if (!dataEl || !input) return;

    const searchDataMap = JSON.parse(dataEl.dataset.json || "{}");
    const tagInputs = document.querySelectorAll('input[name="tag-filter"]');
    const resultsElements = document.querySelectorAll("[data-item]");
    const status = document.getElementById("number-of-results");
    const emptyState = document.getElementById("empty-state");

    function highlightText(text, query) {
      if (!query) return text;
      const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(`(${escapedQuery})`, "gi");
      return text.replace(
        regex,
        '<mark class="bg-skin-accent/30 text-skin-accent rounded-sm px-0.5">$1</mark>'
      );
    }

    function updateSearch(updateUrl = true) {
      const query = input.value.trim().toLowerCase();
      const activeTags = Array.from(tagInputs)
        .filter(i => i.checked)
        .map(i => i.value);
      const isSearchActive = query !== "" || activeTags.length > 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        query ? url.searchParams.set("q", query) : url.searchParams.delete("q");
        url.searchParams.delete("tag");
        activeTags.forEach(tag => url.searchParams.append("tag", tag));
        window.history.replaceState(null, "", url.toString());
      }

      if (!isSearchActive) {
        resultsElements.forEach(el => el.classList.add("hidden"));
        status.innerText = "";
        emptyState.classList.add("hidden");
        tagInputs.forEach(ti => (ti.closest("label").style.opacity = "1"));
        return;
      }

      let visibleCount = 0;
      const globalTagsInResults = new Set();

      resultsElements.forEach(el => {
        const slug = el.getAttribute("data-slug");
        const data = searchDataMap[slug];
        if (!data) return;

        const matchesText =
          query !== "" &&
          (data.title.toLowerCase().includes(query) ||
            data.description.toLowerCase().includes(query) ||
            data.bodyPlainText.toLowerCase().includes(query));
        const matchesTags =
          activeTags.length > 0 && activeTags.some(t => data.tags.includes(t));

        if (matchesText || matchesTags) {
          el.classList.remove("hidden");
          visibleCount++;
          data.tags.forEach(t => globalTagsInResults.add(t));

          el.querySelector('[data-field="title"]').innerHTML = highlightText(
            data.title,
            query
          );
          el.querySelector('[data-field="description"]').innerHTML =
            highlightText(data.description, query);

          const tagContainer = el.querySelector("[data-result-tags]");
          tagContainer.innerHTML = data.tags
            .map(
              t => `
            <span class="text-[10px] px-2 py-0.5 rounded-full border border-skin-fill ${
              activeTags.includes(t)
                ? "bg-skin-accent/10 text-skin-accent border-skin-accent"
                : "opacity-60"
            }">
              #${t}
            </span>
          `
            )
            .join("");
        } else {
          el.classList.add("hidden");
        }
      });

      status.innerText =
        visibleCount > 0 ? `Found ${visibleCount} results` : "No results found";
      emptyState.classList.toggle("hidden", visibleCount > 0);

      tagInputs.forEach(tagInput => {
        const parentLabel = tagInput.closest("label");
        const isSelected = tagInput.checked;
        const isRelated = globalTagsInResults.has(tagInput.value);
        parentLabel.style.opacity =
          query === "" || isSelected || isRelated ? "1" : "0.3";
      });
    }

    input.addEventListener("input", () => updateSearch());
    tagInputs.forEach(t => t.addEventListener("change", () => updateSearch()));

    // Initial Run for URL params
    updateSearch(false);
  }

  // Final Fix: Handle standard loads and Astro transitions
  document.addEventListener("DOMContentLoaded", initSearch);
  document.addEventListener("astro:page-load", initSearch);
</script>
