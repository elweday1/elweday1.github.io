---
import { SOCIALS } from "@config";
import Icon from "astro-icon";
import Socials from "@components/Socials.astro";
import { Image } from "astro:assets";
import siemens from "@public/logos/siemens.svg";
import deepmind from "@public/logos/deepmind.svg";

const socialCount = SOCIALS.filter(social => social.active).length;
---

<section
  class="hero-section relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden px-4"
  aria-labelledby="hero-heading"
>
  <!-- Subtle background -->
  <div class="hero-bg absolute inset-0 overflow-hidden">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
  </div>

  <div
    class="hero-content relative z-10 flex w-full max-w-3xl flex-col items-center text-center"
  >
    <!-- Greeting -->
    <div class="hero-greeting animate-fade-in-up mb-3" data-delay="0">
      <span class="text-sm font-medium text-skin-accent md:text-base"
        >Hi, I'm</span
      >
    </div>

    <!-- Name with RSS as the dot -->
    <div class="hero-name animate-fade-in-up mb-4" data-delay="200">
      <h1
        id="hero-heading"
        class="hero-title text-3xl font-bold leading-tight md:text-4xl lg:text-5xl"
      >
        <span class="name-first">Mohammed</span>
        <span class="name-last">Nasser</span>
        <a
          href="/rss.xml"
          aria-label="RSS Feed"
          class="rss-dot ml-1.5 inline-flex h-2.5 w-2.5 items-center justify-center rounded-full bg-skin-accent transition-all hover:scale-125 hover:bg-skin-accent/80 md:h-3 md:w-3"
          title="RSS Feed"
        >
          <Icon name="ph:rss-bold" class="size-1.5 text-white md:size-2" />
        </a>
      </h1>
    </div>

    <!-- Role -->
    <div class="hero-role animate-fade-in-up mb-6" data-delay="400">
      <h2
        class="text-base font-light uppercase tracking-[0.2em] text-skin-base/70 md:text-lg md:tracking-[0.25em]"
      >
        Software Engineer
      </h2>
    </div>

    <!-- Description -->
    <div
      class="hero-description animate-fade-in-up mb-8 max-w-xl"
      data-delay="600"
    >
      <p class="text-sm leading-relaxed text-skin-base/80 md:text-base">
        A Computer Engineering Student passionate about
        <span class="font-semibold text-skin-accent">open source</span>,
        <span class="font-semibold text-skin-accent">web development</span>, and
        building tools that help people.
      </p>
    </div>

    <!-- Social links -->
    {
      socialCount > 0 && (
        <div class="hero-socials animate-fade-in-up mb-12" data-delay="800">
          <Socials />
        </div>
      )
    }
  </div>

  <!-- Scroll indicator - always visible -->
  <div
    class="scroll-indicator absolute bottom-12 left-1/2 z-30 -translate-x-1/2"
    style="opacity: 1 !important;"
  >
    <div class="-mt-[100px] flex flex-col items-center gap-1.5">
      <span
        class="text-[10px] font-medium uppercase tracking-wider text-skin-base/50"
        >Scroll</span
      >
      <div class="scroll-arrow">
        <Icon name="mdi:chevron-down" class="size-5 text-skin-accent/80" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    pointer-events: none;
    z-index: 0;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.05;
    animation: float 30s ease-in-out infinite;
  }

  .orb-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(var(--color-accent), 0.08) 0%,
      transparent 70%
    );
    top: -150px;
    left: -150px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(
      circle,
      rgba(var(--color-accent), 0.06) 0%,
      transparent 70%
    );
    bottom: -125px;
    right: -125px;
    animation-delay: 15s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(30px, -30px) scale(1.03);
    }
  }

  .hero-title {
    color: rgb(var(--color-skin-base));
  }

  .name-first,
  .name-last {
    display: inline-block;
    color: rgb(var(--color-skin-base));
  }

  .rss-dot {
    vertical-align: middle;
    box-shadow: 0 0 6px rgba(var(--color-accent), 0.3);
  }

  .scroll-arrow {
    animation: bounce-arrow 2s ease-in-out infinite;
  }

  @keyframes bounce-arrow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animate-fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .gradient-orb,
    .scroll-arrow,
    .animate-fade-in-up {
      animation: none !important;
    }

    .animate-fade-in-up {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px",
    };

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = entry.target.dataset.delay || 0;
          setTimeout(() => {
            entry.target.classList.add("visible");
          }, delay);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".animate-fade-in-up").forEach(el => {
      observer.observe(el);
    });
  });

  document.addEventListener("astro:page-load", () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px",
    };

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = entry.target.dataset.delay || 0;
          setTimeout(() => {
            entry.target.classList.add("visible");
          }, delay);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".animate-fade-in-up").forEach(el => {
      observer.observe(el);
    });
  });
</script>
