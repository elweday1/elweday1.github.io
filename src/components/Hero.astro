  ---
import { SOCIALS, HIGHLIGHTS } from "@config";
import Icon from "astro-icon";
import Socials from "@components/Socials.astro";
import { Image } from "astro:assets";
import deepmind from "@public/logos/deepmind.svg";
---

<section
  class="hero-section relative flex min-h-[85vh] w-full flex-col justify-center overflow-hidden px-6 lg:px-12"
  aria-labelledby="hero-heading"
>
  <!-- Minimalist Background Architecture -->
  <div class="hero-bg absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 h-full w-1/3 bg-gradient-to-l from-skin-accent/5 to-transparent"></div>
    <div class="absolute bottom-0 left-0 h-1/2 w-full bg-gradient-to-t from-skin-accent/[0.02] to-transparent"></div>
  </div>

  <div class="container relative z-10 mx-auto max-w-7xl">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      
      <!-- Primary Brand Identity -->
      <div class="max-w-4xl space-y-6">
        <div class="hero-label-wrap animate-reveal" data-delay="0">
          <span class="text-xs font-black uppercase tracking-[0.5em] text-skin-accent/60">SOFTWARE ENGINEER</span>
        </div>
        
        <h1 id="hero-heading" class="hero-title animate-reveal text-6xl font-black leading-[0.9] tracking-tighter text-skin-base sm:text-8xl lg:text-[10rem]" data-delay="200">
          M.NASSER<span class="text-skin-accent">_</span>
        </h1>

        <p class="hero-tagline animate-reveal max-w-2xl text-xl font-medium leading-tight text-skin-base/60 sm:text-3xl" data-delay="400">
          Computer Engineering student at <span class="bg-skin-accent/10 px-2 py-0.5 text-skin-accent rounded-md">Helwan University</span>, Open source enthusiast, fullstack developer.
        </p>
      </div>

      <!-- Compact Social Sidebar -->
      <div class="hero-sidebar animate-reveal flex flex-row items-center gap-6 lg:flex-col lg:items-end lg:justify-end lg:pb-4" data-delay="800">
        <div class="hidden h-24 w-px bg-skin-line/20 lg:block"></div>
        <Socials class="!p-0 !gap-6 flex-row lg:flex-col" />
      </div>
    </div>

    <!-- The "Useful Info" Architecture -->
    <div class="mt-20 grid grid-cols-1 gap-4 border-t border-skin-line/10 pt-12 sm:grid-cols-2 lg:grid-cols-3">
      {HIGHLIGHTS.map((item, i) => (
        <div class="hero-card animate-reveal group relative overflow-hidden rounded-2xl border border-white/5 bg-white/[0.03] p-8 backdrop-blur-sm transition-all hover:bg-white/[0.06] hover:border-skin-accent/20" data-delay={600 + (i * 100)}>
          <div class="relative z-10 space-y-4">
             <div class="flex items-center justify-between">
               <span class="text-[10px] font-bold uppercase tracking-widest text-skin-accent">{item.label}</span>
               <div class="size-1 rounded-full bg-skin-accent group-hover:scale-[3] transition-transform"></div>
             </div>
             <div>
               <h3 class="text-xl font-bold text-skin-base leading-tight">{item.value}</h3>
               <p class="mt-1 text-xs font-medium text-skin-base/40 italic">{item.trend}</p>
             </div>
          </div>
          <!-- Artistic card light -->
          <div class="absolute -bottom-10 -right-10 size-32 rounded-full bg-skin-accent/5 blur-3xl group-hover:bg-skin-accent/10 transition-colors"></div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll Hook -->
  <div class="absolute bottom-6 right-6 lg:bottom-12 lg:right-12">
    <div class="flex items-center gap-4 rotate-90 origin-right translate-x-1/2">
       <span class="text-[10px] font-black uppercase tracking-[0.5em] text-skin-base/20 whitespace-nowrap">Scroll Down</span>
       <div class="h-20 w-px bg-gradient-to-t from-skin-accent to-transparent"></div>
    </div>
  </div>
</section>

<style>
  /* High-End Condensed Typography */
  .hero-title {
    font-family: 'Nunito', sans-serif; /* Fallback, assumes you have a strong sans-serif */
    letter-spacing: -0.05em;
  }

  /* Entrance Animation: Artistic reveal */
  .animate-reveal {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-reveal.show {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  /* Interactive Elements */
  .hero-card {
    cursor: default;
  }

  /* Reduced contrast for bloat control */
  @media (prefers-reduced-motion: reduce) {
    .animate-reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

<script>
  const initHero = () => {
    const items = document.querySelectorAll(".animate-reveal");
    
    // Intersection Observer for the reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = parseInt((entry.target as HTMLElement).dataset.delay || "0");
          setTimeout(() => {
            entry.target.classList.add("show");
          }, delay);
        }
      });
    }, { threshold: 0.1 });

    items.forEach(item => observer.observe(item));

    // Simple parallax for the background orbs (if added back)
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      const title = document.querySelector('.hero-title') as HTMLElement;
      if (title) {
        title.style.transform = `translateY(${scrolled * 0.1}px)`;
      }
    }, { passive: true });
  };

  document.addEventListener("astro:page-load", initHero);
  initHero();
</script>
