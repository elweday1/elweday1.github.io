---
import Datetime from "./Datetime.astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { twMerge } from "tailwind-merge";
import { Icon } from "astro-icon";

export interface Props {
  post: CollectionEntry<"blog">;
  class?: string;
}

const { post, class: className } = Astro.props;
const { slug, data } = post;
const { title, description, dateTime, cover, tags } = data;
const cardCode = `N-${String(
  (Array.from(slug).reduce((sum, char) => sum + char.charCodeAt(0), 0) % 89) + 10
)}`;

const href = `/blog/${slug}`;
---

<li
  data-item-type="search-item"
  data-slug={slug}
  data-card-code={cardCode}
  class={twMerge("work-card note-card group", className)}
>
  <a href={href} class="work-card-anchor" aria-label={`Read ${title}`}>
    <div class="work-card-media">
      <Image
        alt={description}
        width={450}
        height={300}
        format="avif"
        src={cover}
      />
    </div>

    <div class="work-card-body">
      <div class="card-kicker">
        <span>Note</span>
        <Datetime
          datetime={dateTime}
          size="sm"
          class="card-date"
        />
      </div>

      <h2>{title}</h2>

      <p>{description}</p>

      {
        tags.length > 0 && (
          <div class="card-chip-row">
            {tags.slice(0, 2).map((tag: string) => (
              <div class="card-chip" title={tag}>
                <Icon name="ph:hash-bold" />
                <span>{tag}</span>
              </div>
            ))}
            {tags.length > 2 && (
              <div class="card-chip">
                +{tags.length - 2}
              </div>
            )}
          </div>
        )
      }
    </div>
  </a>
</li>
