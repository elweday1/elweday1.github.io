---
import { slugifyStr } from "@utils/slugify";
import Datetime from "./Datetime.astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { twMerge } from "tailwind-merge";
import { Icon } from "astro-icon";

export interface Props {
  post: CollectionEntry<"blog">;
  class?: string;
}

const { post, class: className } = Astro.props;
const { slug, data } = post;
const { title, description, dateTime, cover, tags } = data;
const strTags = tags.map((tag: string) => slugifyStr(tag)).join("/");

const href = `/blog/${slug}`;
---

<li
  transition:name={slug + ":item"}
  data-item-type="search-item"
  data-slug={slug}
  class={twMerge(
    "group relative overflow-hidden rounded-2xl border border-white/5 bg-white/[0.03] backdrop-blur-sm transition-all duration-500 hover:border-skin-accent/30 hover:bg-white/[0.08] hover:shadow-2xl hover:shadow-skin-accent/5",
    className
  )}
>
  <a href={href} class="block" aria-label={`Read ${title}`}>
    <div class="relative aspect-[16/10] overflow-hidden">
      <Image
        transition:name={slug + ":image"}
        alt={description}
        width={450}
        height={300}
        format="avif"
        src={cover}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
      />
      <!-- Artistic gradient overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"
      >
      </div>

      <div class="absolute left-4 top-4">
        <div
          class="rounded-full border border-white/10 bg-black/40 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-white/60 backdrop-blur-md"
        >
          Article
        </div>
      </div>
    </div>

    <div class="p-6">
      <div class="mb-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span
            class="text-[10px] font-black uppercase tracking-[0.3em] text-skin-accent/80"
            >Archived.log</span
          >
        </div>
        <Datetime
          datetime={dateTime}
          size="sm"
          class="text-[10px] font-bold uppercase tracking-widest text-skin-base/30"
        />
      </div>

      <h2
        class="mb-3 text-2xl font-black tracking-tight text-skin-base transition-colors group-hover:text-skin-accent"
        transition:name={slug}
      >
        {title}
      </h2>

      <p class="mb-6 line-clamp-2 text-sm leading-relaxed text-skin-base/60">
        {description}
      </p>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 border-t border-white/5 pt-4">
            {tags.slice(0, 3).map((tag: string) => (
              <div
                class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/5 px-2.5 py-1 transition-colors group-hover:border-skin-accent/20 group-hover:bg-skin-accent/5"
                title={tag}
              >
                <Icon
                  class="size-3 text-skin-base/30 transition-colors group-hover:text-skin-accent"
                  name="ph:hash-bold"
                />
                <span class="text-[10px] font-bold uppercase tracking-wider text-skin-base/40 transition-colors group-hover:text-skin-base">
                  {tag}
                </span>
              </div>
            ))}
            {tags.length > 3 && (
              <div class="flex items-center rounded-lg border border-white/5 bg-white/5 px-2.5 py-1 text-[10px] font-bold text-skin-base/30">
                +{tags.length - 3}
              </div>
            )}
          </div>
        )
      }
    </div>
  </a>

  <!-- Read button overlay -->
  <div
    class="absolute right-6 top-6 translate-y-2 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
  >
    <div
      class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-black/60 text-white backdrop-blur-md transition-all hover:scale-110 hover:border-skin-accent hover:bg-black"
    >
      <Icon class="size-5" name="ph:book-open" />
    </div>
  </div>
</li>
