---
import { type Show } from "@utils/shows";
import Image from "astro/components/Image.astro";
interface Props {
  showsData: Show[];
}

const { showsData } = Astro.props;
---

<div class="slider-container">
  <nav class="slider-nav">
    {
      showsData.map(({ imdbID }) => (
        <a href={`#slide-${imdbID}`} class="nav-dot" />
      ))
    }
  </nav>

  <div class="slides">
    {
      showsData.map(({ imdbID, Poster, Title }) => (
        <div id={`slide-${imdbID}`} class="slide-item group">
          <Image
            src={Poster}
            width={150}
            height={225}
            class="slide-image"
            alt={Title}
          />
          <a
            href={`https://www.imdb.com/title/${imdbID}`}
            class="slide-overlay"
          >
            <span class="slide-title">{Title}</span>
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  .slider-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Navigation Dots */
  .slider-nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav-dot {
    width: 8px;
    height: 8px;
    background: #ccc;
    border-radius: 50%;
    transition:
      background 0.3s,
      transform 0.2s;
  }

  .nav-dot:hover,
  .nav-dot:focus {
    background: #000;
    transform: scale(1.2);
  }

  /* Slides Wrapper */
  .slides {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 1.5rem;
    padding-bottom: 10px;

    /* Hide Scrollbar */
    -ms-overflow-style: none; /* IE/Edge */
    scrollbar-width: none; /* Firefox */
  }

  .slides::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Individual Slide */
  .slide-item {
    flex: 0 0 auto;
    width: 150px; /* Reduced size */
    aspect-ratio: 2/3;
    position: relative;
    scroll-snap-align: center;
    border-radius: 12px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Overlay Logic */
  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-decoration: none;
  }

  .slide-item:hover .slide-overlay {
    opacity: 1;
  }

  .slide-title {
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }
</style>
